+ * doesn't capture. Context only — no count, percentage, QAB status, game
+ * result or record reads it (tallyPlateAppearances and the qab_* views never
+ * look at notes).
+ *
+ * Counted in characters the way Postgres's char_length() counts them (code
+ * points, so an emoji is one), matching plate_appearances_notes_length.
+ */
+export const MAX_NOTE_LENGTH = 280;
+export const NOTE_TOO_LONG_ERROR = `Keep the note to ${MAX_NOTE_LENGTH} characters or fewer.`;
+
+export const noteLength = (value) => [...String(value ?? "")].length;
+
+/** Trimmed; blank becomes null. */
+export function normalizeNote(value) {
+  if (value == null) return null;
+  const trimmed = String(value).trim();
+  return trimmed.length > 0 ? trimmed : null;
+}
+
+/** { ok, note } or { ok: false, error } — refused, never truncated. */
+export function validateNote(value) {
+  const note = normalizeNote(value);
+  if (note !== null && noteLength(note) > MAX_NOTE_LENGTH) {
+    return { ok: false, error: NOTE_TOO_LONG_ERROR };
+  }
+  return { ok: true, note };
+}
+
+/** Two notes are the same once trimmed; no note and a blank note are equal. */
+export const sameNote = (a, b) => normalizeNote(a) === normalizeNote(b);
