 }
+
+/* ---- Import Players: required field, and the mobile viewport ------------ */
+
+/* A required destination reads as a statement, not a control. Deliberately
+   not a disabled checkbox: a greyed tickbox still invites the tap and still
+   answers "no" when tapped. */
+.pi-required {
+  display: inline-flex; align-items: center;
+  font-size: 11px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase;
+  padding: 3px 9px; border-radius: 999px;
+  background: var(--surface-sunken); border: 1px solid var(--border); color: var(--slate);
+}
+
+@media (max-width: 720px) {
+  /* THE LAST MAPPING ROW WAS UNREACHABLE.
+     .drawer is height: 100% inside a position: fixed backdrop, which resolves
+     against the LAYOUT viewport — on iOS Safari that includes the strip behind
+     the bottom toolbar. The drawer was therefore taller than the visible area
+     and its final rows sat under browser chrome, with the scroll container
+     already at its end so nothing could bring them up.
+     100dvh is the visible height and shrinks as the toolbar appears. The
+     height: 100% above remains as the fallback for anything without dvh. */
+  .drawer { height: 100dvh; }
+
+  /* Only pads when there IS an inset, so no double gap on a device without
+     one. The 16px is the existing .drawer-body padding, not an addition. */
+  .drawer-body { padding-bottom: calc(16px + env(safe-area-inset-bottom, 0px)); }
+
+  /* A 44px target without changing the row's density: the label grows into
+     the space the row already has rather than making the row taller. */
+  .pi-switch { min-height: 44px; }
+  .pi-switch input { width: 20px; height: 20px; }
+  .pi-required { min-height: 44px; }
+}
+
+/* ---- Contact editing: errors where the action happened ------------------ */
+
+/* Inside the edit card, directly above its buttons. The panel-level alert
+   still exists for actions that belong to no form, but an edit's refusal
+   belongs to the edit. */
+.pc-form-error {
+  margin: 2px 0 10px; padding: 9px 11px;
+  border-radius: var(--radius-control);
+  background: #fdf2f2; border: 1px solid #f0c9c9; color: #8a2c2c;
+  font-size: 13px; line-height: 1.5;
+}
+
+/* The empty-contact choice. Offers removal; never performs it. */
+.pc-empty-offer {
+  margin: 2px 0 10px; padding: 11px 13px;
+  border-radius: var(--radius-control);
+  background: #fffaf0; border: 1px solid #f0d9a8; color: #6b4a00;
+  display: flex; flex-direction: column; align-items: flex-start; gap: 9px;
+}
+.pc-empty-offer p { margin: 0; font-size: 13px; line-height: 1.5; }
+
+/* In-page removal confirmation. Replaces window.confirm(), which a mobile
+   browser can suppress silently — the tap then did nothing at all, with no
+   request and no message. */
+.pc-confirm {
+  margin-top: 10px; padding: 11px 13px;
+  border-radius: var(--radius-control);
+  background: #fdf2f2; border: 1px solid #f0c9c9;
+  display: flex; flex-direction: column; gap: 9px;
+}
+.pc-confirm p { margin: 0; font-size: 13px; line-height: 1.5; color: #8a2c2c; }
+
+@media (max-width: 720px) {
+  /* Same reach as every other control in the drawer. */
+  .pc-confirm .btn, .pc-empty-offer .btn { min-height: 44px; }
+}
+
+/* ---- Drawer mutation feedback ------------------------------------------ */
+
+/* Inside the drawer footer, above its actions. The page-level alert sits
+   underneath a fixed full-height drawer and cannot be seen on a phone. */
+.drawer-foot-error {
+  margin: 0 0 10px; padding: 9px 11px;
+  border-radius: var(--radius-control);
+  background: #fdf2f2; border: 1px solid #f0c9c9; color: #8a2c2c;
+  font-size: 13px; line-height: 1.5;
+}
+
+/* Destructive confirmation, in place of the action row. */
+.drawer-confirm { display: flex; flex-direction: column; gap: 10px; }
+.drawer-confirm p {
+  margin: 0; font-size: 13px; line-height: 1.55; color: var(--navy);
+}
+
+@media (max-width: 720px) {
+  .drawer-confirm .btn { min-height: 44px; }
+  .drawer-confirm .drawer-foot-row { flex-direction: column; gap: 8px; }
+  .drawer-confirm .drawer-foot-row .btn { width: 100%; }
+}
+
+/* ---- In-app confirmation, shared ---------------------------------------- */
+.confirm-inline {
+  margin: 10px 0; padding: 12px 14px;
+  border-radius: var(--radius-control);
+  background: #fdf2f2; border: 1px solid #f0c9c9;
+  display: flex; flex-direction: column; gap: 10px;
+}
+.confirm-inline-message {
+  margin: 0; font-size: 13px; line-height: 1.55; color: #8a2c2c;
+}
+.confirm-inline-error {
+  margin: 0; font-size: 13px; line-height: 1.5; color: #8a2c2c; font-weight: 600;
+}
+.confirm-inline-actions { display: flex; gap: 8px; flex-wrap: wrap; }
+
+@media (max-width: 720px) {
+  .confirm-inline-actions { flex-direction: column; }
+  .confirm-inline-actions .btn { width: 100%; min-height: 44px; }
+}
+
+/* ---- Files on a phone ---------------------------------------------------
+   The desktop table has five columns; squeezed onto a 375px screen the last
+   two sat off the right edge with no indication they existed, and the view
+   tabs pushed the page into horizontal scroll. Desktop keeps its table. The
+   phone gets a list built from the same rows, showing what a coach actually
+   needs: the file, what it belongs to, and how to open it. */
+
+/* Desktop keeps the table and never renders the list. Declared BEFORE the
+   media query: same specificity, so a later rule would win and hide the list
+   at every width — which is exactly what happened, leaving a phone with the
+   table hidden, the list hidden, and a tab count of 1 above nothing. */
+.files-list { display: none; }
+
+@media (max-width: 720px) {
+  /* Tabs scroll THEMSELVES rather than widening the page. */
+  .files-views {
+    display: flex; flex-wrap: nowrap;
+    overflow-x: auto; -webkit-overflow-scrolling: touch;
+    overscroll-behavior-x: contain;
+    scrollbar-width: none;
+  }
+  .files-views::-webkit-scrollbar { display: none; }
+  .files-views > * { flex: 0 0 auto; min-height: 40px; }
+
+  /* Search above, filter below, both full width — the two were sharing a row
+     narrow enough to clip the select's label. */
+  .files-views + .toolbar { flex-direction: column; align-items: stretch; gap: 8px; }
+  .files-views + .toolbar .toolbar-search,
+  .files-views + .toolbar .filter-select { width: 100%; min-height: 44px; }
+
+  /* The table is replaced, not reflowed. */
+  .files-table { display: none; }
+  .files-list { display: grid; gap: 8px; }
+}
+
+.files-card {
+  width: 100%; text-align: left; cursor: pointer;
+  display: grid; gap: 6px;
+  padding: 12px 14px; min-height: 44px;
+  background: var(--surface); border: 1px solid var(--border);
+  border-radius: var(--radius-control); font-family: inherit;
+}
+.files-card:hover { background: var(--surface-sunken); }
+
+/* A long filename wraps to two lines and then stops, rather than pushing the
+   card wider than the screen. */
+.files-card-name {
+  font-size: 14.5px; font-weight: 600; color: var(--navy); line-height: 1.35;
+  overflow-wrap: anywhere;
+  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+.files-card-meta {
+  display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px;
+  font-size: 12.5px; color: var(--slate);
+}
+.files-card-meta .pill { flex: 0 0 auto; }
+.files-card-related { overflow-wrap: anywhere; }
+
+/* ---- Error and not-found pages ----------------------------------------- */
+.errpage {
+  min-height: 60vh; display: flex; align-items: center; justify-content: center;
+  padding: 32px 20px;
+}
+.errpage-card {
+  max-width: 460px; width: 100%;
+  background: var(--surface); border: 1px solid var(--border);
+  border-radius: var(--radius-control); padding: 28px 26px;
+}
+.errpage-eyebrow {
+  margin: 0 0 6px; font-size: 12px; letter-spacing: 0.08em;
+  text-transform: uppercase; color: var(--slate);
+}
+.errpage-title {
+  margin: 0 0 10px; font-size: 24px; line-height: 1.25; color: var(--navy);
+}
+.errpage-body {
+  margin: 0 0 20px; font-size: 15px; line-height: 1.6; color: var(--slate);
+}
+.errpage-actions { display: flex; gap: 10px; flex-wrap: wrap; }
+.errpage-ref {
+  margin: 18px 0 0; font-size: 12.5px; color: var(--slate);
+}
+.errpage-ref code {
+  font-size: 12.5px; background: var(--surface-sunken, #f1f5f9);
+  padding: 2px 6px; border-radius: 4px;
+}
+
+@media (max-width: 720px) {
+  .errpage-actions { flex-direction: column; }
+  .errpage-actions .btn { width: 100%; min-height: 44px; }
+}
diff --git a/app/not-found.js b/app/not-found.js
new file mode 100644
index 0000000..5108e34
--- /dev/null
+++ b/app/not-found.js
@@ -0,0 +1,32 @@
+import Link from "next/link";
+
+/**
+ * A mistyped or stale URL. Polish, not a data risk — but a coach following an
+ * old link should land somewhere that looks like Season Tempo and offers a way
+ * back, rather than on a bare framework 404.
+ *
+ * Deliberately says nothing about whether the thing existed: "no page here"
+ * covers a typo and a record in another organization identically, so this
+ * cannot be used to probe what exists.
+ */
+export default function NotFound() {
+  return (
+    <div className="errpage">
+      <div className="errpage-card">
+        <p className="errpage-eyebrow">Page not found</p>
+        <h1 className="errpage-title">There&rsquo;s no page here</h1>
+        <p className="errpage-body">
+          The link may be out of date, or the address may have a typo in it.
+        </p>
+        <div className="errpage-actions">
+          <Link className="btn btn-primary" href="/dashboard">
+            Go to your dashboard
+          </Link>
+          <Link className="btn btn-secondary" href="/">
+            Season Tempo home
+          </Link>
+        </div>
+      </div>
+    </div>
+  );
+}
