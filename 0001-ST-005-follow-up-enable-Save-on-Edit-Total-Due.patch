+/**
+ * Whether the dues form (PaymentForm) may be submitted. ST-005 follow-up.
+ *
+ * One rule for the three ways that form opens, so the button and its tests
+ * read from the same place:
+ *
+ *   "edit" — one player's existing obligation (Edit total due). Savable only
+ *            when the amount is a real number that differs from what is
+ *            already recorded, compared in whole cents so 2400 and "2400.00"
+ *            count as the same. The payment floor is NOT checked here: the
+ *            server (savePlayerPayment) is the authority on what has been
+ *            paid, and its rejection message is shown inside the form.
+ *   "bulk" — Set dues for all players, or Edit team dues. Savable when at
+ *            least one player is selected (unchanged from before).
+ *   "one"  — Set dues for one player. Always savable; the browser's own
+ *            required-field checks cover the inputs (unchanged from before).
+ *
+ * Nothing is savable while a save is already in flight.
+ */
+export function canSaveDuesForm({ pending = false, mode, amount, originalAmount = null, selectedCount = 0 }) {
+  if (pending) return false;
+  if (mode === "edit") {
+    if (amount === "" || amount == null) return false;
+    const value = Number(amount);
+    if (!Number.isFinite(value) || value < 0) return false;
+    return cents(value) !== cents(originalAmount);
+  }
+  if (mode === "bulk") return selectedCount > 0;
+  return true;
+}
+
 /**
  * Splits a team total across players so the parts add back to the whole.
  *
