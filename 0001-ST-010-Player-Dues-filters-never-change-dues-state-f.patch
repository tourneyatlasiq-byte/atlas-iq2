+/* ------------------------------------------------------------------------
+ * PLAYER DUES UNDER A FILTER (ST-010, 2026-11).
+ *
+ * The defect: the Player Dues list used to reconcile the roster against only
+ * the dues records that matched the active Needs Attention filter. A player
+ * whose record was filtered out then had "no record", and was displayed as
+ * "Dues not set" — Allie Cox, $3,600 due and $3,600 paid, showed that way
+ * under "players owing". The dues form, which saw every record, correctly
+ * refused to create a second obligation, so the coach hit a dead end.
+ *
+ * The rule now: dues state is ALWAYS reconciled from the complete season
+ * dataset. A filter only decides which already-reconciled rows are shown.
+ * Financial actions are decided from the complete dataset too, never from
+ * what happens to be on screen.
+ * ---------------------------------------------------------------------- */
+
+/**
+ * The players a Needs Attention action is about, as a Set of player ids.
+ *
+ * `affected` carries player_payments rows for "outstanding" and
+ * "not-started", and team_season_players rows for "no-dues". player_id is the
+ * one field both shapes share. null means "no filter".
+ */
+export function actionPlayerIds(action) {
+  if (!action) return null;
+  return new Set((action.affected ?? []).map((a) => a?.player_id).filter(Boolean));
+}
+
+/**
+ * Narrow an already-reconciled result to the filter's players.
+ *
+ * Takes reconcileDues() OUTPUT, never its input: states were decided against
+ * every record before this runs, so narrowing can hide a row but cannot change
+ * what any row says. Counts are recomputed over the rows still shown, so the
+ * view chips match the list beneath them.
+ */
+export function scopeReconciledDues(reconciled, playerIds) {
+  if (!playerIds) return reconciled;
+  const keep = (r) => r.playerId != null && playerIds.has(r.playerId);
+  const roster = reconciled.roster.filter(keep);
+  const former = reconciled.former.filter(keep);
+  const inState = (s) => roster.filter((r) => r.state === s).length;
+  return {
+    roster,
+    former,
+    counts: {
+      all: roster.length,
+      paid: inState("paid"),
+      notStarted: inState("not-started"),
+      notSet: inState("not-set"),
+      exempt: inState("exempt"),
+      owes: roster.filter((r) => r.record && r.record.balance > 0).length,
+      former: former.filter((f) => f.kind === "former").length,
+      unlinked: former.filter((f) => f.kind === "unlinked").length,
+      orphaned: former.filter((f) => f.kind === "orphaned").length,
+    },
+  };
+}
+
+/**
+ * What the Player Dues header states and offers, from the COMPLETE season.
+ *
+ * Pass every dues record for the season and the full reconciliation. Never a
+ * filtered list: filtering the screen must not change which actions the
+ * application treats as permissible. Under a "not paid anything" filter the
+ * old header saw no payments and offered Edit team dues to a team that had
+ * recorded payments (the server still refused it).
+ *
+ * canBulkEdit keeps the existing rule exactly: dues exist and nothing has
+ * been paid on any of them.
+ */
+export function duesHeaderState(payments = [], fullCounts = { notSet: 0 }) {
+  const withDues = (payments ?? []).filter((p) => p.totalDue != null);
+  const anyPaid = (payments ?? []).some((p) => (p.log ?? []).length > 0);
+  return {
+    withDuesCount: withDues.length,
+    duesTotal: sumMoney(withDues.map((p) => p.totalDue ?? 0)),
+    anyPaid,
+    playersWithoutDues: fullCounts.notSet ?? 0,
+    canBulkEdit: withDues.length > 0 && !anyPaid,
+  };
+}
+
+/**
+ * Where "Set dues" for one known player should lead.
+ *
+ *   { kind: "set", player }              no obligation: set it directly
+ *   { kind: "exists", player, record }   already has one: go to it, never an
+ *                                        empty selector
+ *   { kind: "ineligible", playerId }     not an active player this season
+ *
+ * Decided from the complete dues records, the same data the server's
+ * one-row-per-player-per-season rule protects.
+ */
+export function presetDuesTarget(presetPlayerId, players = [], existing = []) {
+  if (!presetPlayerId) return null;
+  const record = (existing ?? []).find((p) => p.player_id === presetPlayerId) ?? null;
+  const player = (players ?? []).find((p) => p.id === presetPlayerId) ?? null;
+  if (record) return { kind: "exists", player, record };
+  if (player && (player.person_type ?? "player") === "player") return { kind: "set", player };
+  return { kind: "ineligible", playerId: presetPlayerId };
+}
+
