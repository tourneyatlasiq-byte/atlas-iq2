+
+/* A short confirmation, not a form. Narrower than the editing modals so the
+   question reads as a question. */
+.modal-confirm { max-width: 460px; }
+.modal-confirm .modal-body { padding-top: 4px; }
+.modal-confirm .modal-foot { display: flex; justify-content: flex-end; gap: 8px; }
+
+@media (max-width: 720px) {
+  .modal-confirm .modal-foot { flex-direction: column-reverse; }
+  .modal-confirm .modal-foot .btn { width: 100%; min-height: 44px; }
+}
+
+/* What is blocking a budget line from being deleted. Each row opens that
+   transaction, so the modal is the route to fixing it rather than a notice
+   about it. */
+.blocker-list { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 6px; }
+.blocker-open {
+  width: 100%; display: flex; align-items: baseline; justify-content: space-between;
+  gap: 12px; padding: 9px 12px; cursor: pointer; text-align: left;
+  background: var(--surface-sunken, #f8fafc);
+  border: 1px solid var(--border); border-radius: var(--radius-control);
+  font: inherit; color: inherit;
+}
