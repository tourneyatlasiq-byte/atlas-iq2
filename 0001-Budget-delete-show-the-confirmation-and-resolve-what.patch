index cf0fafe..ae0f746 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -6128,3 +6128,37 @@ td.committed { color: var(--status-wait); font-weight: 600; }
   .dues-budget-actions { width: 100%; flex-direction: column; }
   .dues-budget-actions .btn { width: 100%; min-height: 44px; }
