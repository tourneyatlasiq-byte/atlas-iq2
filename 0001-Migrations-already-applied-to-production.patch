 ...181427_drop_legacy_budget_items_actual.sql |  32 ++
 ...0260830183041_drop_legacy_player_stats.sql |  33 ++
 4 files changed, 716 insertions(+)
 create mode 100644 supabase/migrations/20260830014649_intake_apply_address_and_change_counting.sql
 create mode 100644 supabase/migrations/20260830180256_intake_run_provenance.sql
 create mode 100644 supabase/migrations/20260830181427_drop_legacy_budget_items_actual.sql
