-      name: p.player?.full_name ?? null,
+      // Current name, then the name STORED on the obligation, then nothing.
+      // player_payments.player_id is SET NULL when a player is deleted so the
+      // money survives — but the embedded player then resolves to null and the
+      // record displayed as "No player linked" with no name at all. Six
+      // Georgia Power obligations carrying that whole season's dues showed
+      // that way. The stored name is what the obligation was created with; it
+      // is read, never written back, and the record stays detached.
+      name: p.player?.full_name ?? p.player_name ?? null,
       record: p,
       kind: !p.player_id
